{
  "name": "handbag-collection",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "pretest": "npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write src supabase/functions tests/e2e playwright.config.js vercel.json",
    "format:check": "prettier --check src supabase/functions tests/e2e playwright.config.js vercel.json",
    "check": "npm run format:check && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.117.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.9.10",
    "vite": "6.4.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.9.0"
}
